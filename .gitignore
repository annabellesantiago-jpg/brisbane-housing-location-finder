# -- ignore python virtual environment --
.venv/
venv/

# -- ignore python caches
__pycache__/
*.pyc
*.pyo

# -- ignore python secrets
.env, .databrickscfg

# -- ignore bundle local state
.databricks/

# -- ignore raw data files
*.geojson, *.parquet, *.csv

